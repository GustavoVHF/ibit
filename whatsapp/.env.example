# =====================================================================
# IBIT · WhatsApp (Evolution API + automação)
# Copie para whatsapp/.env ou rode: powershell -File whatsapp/scripts/setup.ps1
# (o setup gera as chaves automaticamente)
# =====================================================================

# ---------- Evolution API ----------
EVOLUTION_IMAGE_TAG=v2.3.7
EVOLUTION_PORT=8080
# Chave global da Evolution API (header "apikey"). Gere uma aleatória.
EVOLUTION_API_KEY=troque_por_uma_chave_aleatoria
# Nome da instância (sessão do seu WhatsApp)
EVOLUTION_INSTANCE=ibit

# ---------- Postgres da Evolution ----------
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque_por_uma_senha_aleatoria

# ---------- Automação IBIT ----------
AUTOMATION_PORT=3333
# Chave para chamar as rotas da automação (header "x-api-key" ou ?key=)
AUTOMATION_API_KEY=troque_por_uma_chave_aleatoria
# Banco Firestore da plataforma (não é o "(default)")
FIRESTORE_DATABASE_ID=ai-studio-f3c49800-953a-4256-9966-e5f505300c6d
# URL pública da plataforma (links nas mensagens)
APP_URL=https://ibitcrn.vercel.app
TIMEZONE=America/Sao_Paulo

# Grupo padrão (opcional). O recomendado é selecionar pelo script
# scripts/groups.ps1, que salva o vínculo no Firestore (whatsappIntegrations).
DEFAULT_PROJECT_ID=
WHATSAPP_GROUP_ID=

# ---------- Alertas de prazo ----------
# Cron (fuso TIMEZONE). Padrão: todo dia às 08:00
DEADLINE_CRON=0 8 * * *
# Janelas de aviso em dias antes do prazo (cada janela é enviada 1x por tarefa)
DEADLINE_ALERT_DAYS=3,1,0
# Avisar 1x quando a tarefa atrasar (só atrasos dos últimos N dias)
DEADLINE_ALERT_OVERDUE=true
OVERDUE_LOOKBACK_DAYS=7

# ---------- Relatório semanal ----------
# Dia da semana: 0=domingo 1=segunda ... 5=sexta 6=sábado
WEEKLY_REPORT_DAY=5
WEEKLY_REPORT_TIME=17:00

# ---------- Comandos no grupo (/kpis /tarefas /gantt /prazos /financeiro /ajuda) ----------
# A automação configura o webhook da Evolution sozinha ao iniciar.
COMMANDS_ENABLED=true
# Segredo do webhook (header x-webhook-secret). Gerado pelo setup.
WEBHOOK_SECRET=troque_por_uma_chave_aleatoria
# Mesmo comando repetido no grupo dentro desse tempo é ignorado
COMMAND_COOLDOWN_SEC=10
# Comandos mais antigos que isso são ignorados (evita responder histórico)
COMMAND_MAX_AGE_SEC=300
# Janela padrão do /prazos
COMMAND_DEADLINE_DAYS=7
# /mover: qualquer membro do grupo pode mudar tarefas de coluna (false desliga)
COMMAND_MOVE_ENABLED=true
# /criartarefa: cria tarefas no Kanban pelo WhatsApp (false desliga)
COMMAND_CREATE_ENABLED=true

# ---------- Comandos no privado (conversa direta com o seu número) ----------
# members = só quem participa do grupo vinculado · all = qualquer pessoa · off = desligado
PRIVATE_COMMANDS=members
# Números liberados mesmo fora do grupo (com DDI, separados por vírgula). Ex.: 5533999999999,5511988887777
PRIVATE_ALLOWED_NUMBERS=
# Projeto usado no privado para números liberados (vazio = o primeiro grupo vinculado)
PRIVATE_PROJECT_ID=

# Ao iniciar, envia o que ficou pendente (PC desligado no horário)
RUN_CATCHUP_ON_STARTUP=true
MAX_SEND_ATTEMPTS=3
